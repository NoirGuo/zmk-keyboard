#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 35    // 10
#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/rgb.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

&lt {
    flavor = "tap-preferred";
    quick-tap-ms = <180>;
};

/ {
  zip_scroll_scaler: zip_scroll_scaler {
    compatible = "zmk,input-processor-scaler";
    #input-processor-cells = <2>;
    type = <INPUT_EV_REL>;
    codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
    track-remainders;
  };
};

&mmv_input_listener {
       input-processors = <&zip_xy_scaler 2 1>;
};

&msc_input_listener {
       input-processors = <&zip_scroll_scaler 2 1>;
};

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <0>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <400>;
    acceleration-exponent = <1>;
};

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <30>;
    };

    keymap {
        compatible = "zmk,keymap";

        LAYER0 {
            bindings = <
&kp ESC     &kp N1           &kp N2          &kp N3     &kp N4      &kp N5           &kp N6    &kp N7     &kp N8     &kp N9     &kp N0     &kp BACKSPACE
&kp TAB     &kp Q            &kp W           &kp E      &kp R       &kp T            &kp Y     &kp U      &kp I      &kp O      &kp P      &kp BSLH
&kp CAPS    &kp A            &kp S           &kp D      &kp F       &kp G            &kp H     &kp J      &kp K      &kp L      &kp SEMI   &kp ENTER
&kp LSHIFT  &kp Z            &kp X           &kp C      &kp V       &kp B            &kp N     &kp M      &kp COMMA  &kp DOT    &kp FSLH   &kp RSHIFT
            &mt LCTRL MINUS  &mt LALT EQUAL  &kp GRAVE  &lt 1 LGUI  &lt 2 BACKSPACE  &kp RBKT  &lt 1 DEL  &kp LBKT   &kp SPACE  &lt 2 SQT
                                                                                     &kp LEFT  &lt 2 SQT  &kp DOWN   &kp RIGHT  &kp UP
            >;

            display-name = "QWERT";
            sensor-bindings = <&inc_dec_kp DOWN UP>;
        };

        layer_1 {
            bindings = <
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5    &kp F6          &kp F7    &kp F8          &kp F9           &kp F10       &kp F11
&trans  &trans  &trans  &trans  &trans  &trans    &kp HOME        &trans    &kp UP          &trans           &trans        &kp F12
&trans  &trans  &trans  &trans  &trans  &trans    &kp END         &kp LEFT  &kp DOWN        &kp RIGHT        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans          &trans    &trans          &trans           &trans        &trans
        &trans  &trans  &trans  &trans  &mkp MB3  &kp PG_DN       &mkp MB2  &kp PG_UP       &mkp MB1         &trans
                                                  &mmv MOVE_LEFT  &trans    &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mmv MOVE_UP
            >;

            display-name = "MOUSE";
            sensor-bindings = <&scroll_encoder>;
        };

        layer_2 {
            display-name = "CONTROL";
            bindings = <
&studio_unlock   &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4  &trans       &trans  &trans  &trans  &trans  &trans
&trans           &bt BT_CLR       &bt BT_CLR_ALL   &trans           &trans           &bootloader   &bootloader  &trans  &trans  &trans  &trans  &trans
&rgb_ug RGB_BRI  &rgb_ug RGB_SPI  &rgb_ug RGB_SAI  &rgb_ug RGB_HUI  &rgb_ug RGB_EFF  &trans        &trans       &trans  &trans  &trans  &trans  &trans
&rgb_ug RGB_BRD  &rgb_ug RGB_SPD  &rgb_ug RGB_SAD  &rgb_ug RGB_HUD  &rgb_ug RGB_EFR  &trans        &trans       &trans  &trans  &trans  &trans  &trans
                 &trans           &trans           &rgb_ug RGB_TOG  &trans           &trans        &trans       &trans  &trans  &trans  &trans
                                                                                                   &trans       &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                                &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                                &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };
    };
};
