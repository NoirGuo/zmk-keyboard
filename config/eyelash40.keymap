#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp TAB        &kp Q   &kp W   &kp E            &kp R           &kp T          &kp Y      &kp U      &kp I      &kp O       &kp P     &kp BSLH
&mt LGUI CAPS  &kp A   &kp S   &kp D            &kp F           &kp G          &kp H      &kp J      &kp K      &kp L       &kp SEMI  &kp ENTER
&kp LSHFT      &kp Z   &kp X   &kp C            &kp V           &kp B          &kp N      &kp M      &kp COMMA  &kp PERIOD  &kp FSLH  &kp MINUS
                               &mt LCTRL MINUS  &mt LALT EQUAL  &lt 1 GRAVE    &lt 2 SQT  &kp SPACE &mkp MB1        &mkp MB2       &kp DEL
            >;
        };

    };
};
