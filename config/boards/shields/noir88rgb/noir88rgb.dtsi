            , <&key_physical_attrs 100 100  525  112       0     0     0>
            , <&key_physical_attrs 100 100  625  100       0     0     0>
            , <&key_physical_attrs 100 100  725  112       0     0     0>
            , <&key_physical_attrs 100 100  825  125       0     0     0>
            , <&key_physical_attrs 100 100  925  150       0     0     0>
            , <&key_physical_attrs 100 100 1300  150       0     0     0>
