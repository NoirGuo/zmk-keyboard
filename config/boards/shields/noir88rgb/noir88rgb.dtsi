            , <&key_physical_attrs 100 100  925  350       0     0     0>
            , <&key_physical_attrs 100 100 1300  350       0     0     0>
            , <&key_physical_attrs 100 100 1400  325       0     0     0>
            , <&key_physical_attrs 100 100 1500  312       0     0     0>
            , <&key_physical_attrs 100 100 1600  300       0     0     0>
            , <&key_physical_attrs 100 100 1700  312       0     0     0>
