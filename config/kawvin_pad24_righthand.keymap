#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        NUMBER {
            //  ---------------------------------------------------------------------------------
            //  |ESC        |TAB  |BSPC        |EQUAL|
            //  |NLCK       |SLASH|MULTIPLY    |MINUS|
            //  |7          |8    |9           |PLUS |
            //  |4          |5    |6           |     |
            //  |1          |2    |3           |ENTER|
            //  |&lt 2 KP_N0|     |&lt 5 KP_DOT|     |

            bindings = <
&lt 1 ESC  &kp BACKSPACE  &kp DEL          &lt 2 KP_EQUAL
&kp TAB    &kp KP_SLASH   &kp KP_MULTIPLY  &kp KP_MINUS
&kp KP_N7  &kp KP_N8      &kp KP_N9        &kp KP_PLUS
&kp KP_N4  &kp KP_N5      &kp KP_N6
&kp KP_N1  &kp KP_N2      &kp KP_N3        &kp KP_ENTER
&kp KP_N0  &kp KP_DOT
            >;
        };

        MOVE {
            bindings = <
&trans      &trans    &trans     &trans
&kp KP_NUM  &trans    &trans     &trans
&trans      &kp UP    &trans     &trans
&kp LEFT    &trans    &kp RIGHT
&trans      &kp DOWN  &trans     &trans
&trans      &trans
            >;
        };

        contrl_layer {
            //  ---------------------------------------------------------------------------------
            //  |    |    |    |    |
            //  |    |    |    |    |
            //  |    |    |    |    |
            //  |    |    |    |    |
            //  |    |    |    |    |
            //  |    |    |    |    |

            bindings = <
&rgb_ug RGB_TOG  &rgb_ug RGB_SPI  &rgb_ug RGB_SPD  &trans
&rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_BRI  &rgb_ug RGB_EFF
&rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_BRD  &bootloader
&bt BT_SEL 3     &bt BT_SEL 4     &trans
&bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &studio_unlock
&bt BT_CLR       &bt BT_CLR_ALL
            >;
        };
    };
};
