#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
};

&sk {
    release-after-ms = <2000>;
    quick-release;
};

/ {
    combos {
        compatible = "zmk,combos";

        c1 {
            bindings = <&kp N1>;
            key-positions = <4 5>;
        };

        c2 {
            bindings = <&kp NUMBER_2>;
            key-positions = <15 16>;
        };

        c3 {
            bindings = <&kp NUMBER_3>;
            key-positions = <16 17>;
        };

        c4 {
            bindings = <&kp NUMBER_4>;
            key-positions = <27 28>;
        };

        c5 {
            bindings = <&kp N5>;
            key-positions = <28 29>;
        };

        c6 {
            bindings = <&kp NUMBER_6>;
            key-positions = <18 19>;
        };

        c7 {
            bindings = <&kp N7>;
            key-positions = <19 20>;
        };

        c8 {
            bindings = <&kp N8>;
            key-positions = <20 21>;
        };

        c9 {
            bindings = <&kp N9>;
            key-positions = <30 31>;
        };

        c0 {
            bindings = <&kp N0>;
            key-positions = <31 32>;
        };

        cx {
            bindings = <&kp DOWN_ARROW>;
            key-positions = <35 34>;
        };
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <180>;
            global-quick-tap;
        };

        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "hold-preferred";
            bindings = <&mo>, <&kp>;

            quick-tap-ms = <180>;
        };

        as: as {
            compatible = "zmk,behavior-hold-tap";
            label = "AUTO_SHIFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <135>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
        };
    };

    macros {
        xiayihang: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_ARROW &kp ENTER>;
            label = "NEW_MACRO";
        };

        youxiang: youxiang {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N8 &kp N9 &kp NUMBER_4 &kp NUMBER_2 &kp NUMBER_4 &kp NUMBER_2 &kp NUMBER_1 &kp N0 &kp N0 &kp Q &kp Q &kp DOT &kp C &kp O &kp M>;
            label = "YOUXIANG";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC           &kp Q  &kp W  &kp E      &kp R  &kp T      &kp Y      &kp U  &kp I            &kp O    &kp P           &kp BACKSPACE
&kp CAPSLOCK      &kp A  &kp S  &kp D      &kp F  &kp G      &kp H      &kp J  &kp K            &kp L    &kp UP          &kp BACKSLASH
&kp LS(LEFT_ALT)  &kp Z  &kp X  &kp C      &kp V  &kp B      &kp N      &kp M  &kp COMMA        &kp DOT  &kp LEFT_ARROW  &kp RIGHT
                  &none  &none  &kp LCTRL  &mo 1  &kp ENTER  &kp SPACE  &mo 2  &kp RIGHT_SHIFT  &none    &none
            >;
        };

        lower_layer {
            bindings = <
&kp TILDE     &kp LS(NUMBER_1)      &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp LS(N5)             &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4     &bt BT_CLR_ALL
&kp TAB       &kp LS(LEFT_BRACKET)  &kp RS(COMMA)     &kp LS(NUMBER_6)  &kp RS(SEMI)      &kp RS(DOUBLE_QUOTES)  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_BRI  &rgb_ug RGB_SPI  &rgb_ug RGB_EFF  &none
&kp LEFT_GUI  &none                 &kp LS(N9)        &kp SEMICOLON     &kp RS(QUESTION)  &kp LS(NUMBER_1)       &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_BRD  &rgb_ug RGB_SPD  &rgb_ug RGB_EFR  &none
              &none                 &none             &mo 3             &trans            &trans                 &rgb_ug RGB_TOG  &none            &trans           &none            &none
            >;
        };

        raise_layer {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4   &kp F5   &kp F6   &kp RS(NUMBER_6)  &kp RS(N7)     &kp RS(ASTERISK)  &kp RS(N9)  &kp RS(N0)  &kp DEL
&kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12  &kp MINUS         &kp EQUAL      &kp PG_UP         &kp HOME    &none       &trans
&trans  &none   &none   &none    &none    &none    &kp RS(MINUS)     &kp RS(EQUAL)  &kp PAGE_DOWN     &kp END     &trans      &trans
        &none   &none   &trans   &trans   &trans   &trans            &trans         &mo 4             &none       &none
            >;
        };

        layer_3 {
            bindings = <
&none  &none  &none  &none  &kp KP_PLUS      &kp KP_SUBTRACT  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &none  &none  &none
&none  &none  &none  &none  &kp KP_MULTIPLY  &kp KP_DIVIDE    &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &none  &none  &none
&none  &none  &none  &none  &kp KP_NUMBER_0  &kp KP_DOT       &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &none  &none  &none
       &none  &none  &none  &to 0            &kp ENTER        &none            &none            &none            &none  &none
            >;
        };

        layer_4 {
            bindings = <
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
       &none  &none  &none  &to 0  &none  &none  &none  &none  &none  &none
            >;
        };

        layer_5 {
            bindings = <
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
       &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };

        layer_6 {
            bindings = <
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
       &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };

        layer_7 {
            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none  &none  &none  &none  &none  &none
&none  &bt BT_CLR    &none         &none         &none         &to 0         &none  &none  &none  &none  &none  &none
&none  &none         &none         &none         &none         &none         &none  &none  &none  &none  &none  &none
       &none         &none         &none         &none         &none         &none  &none  &none  &none  &none
            >;
        };
    };
};
