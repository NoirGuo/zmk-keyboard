#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define ZMK_MOUSE_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 20    // 10
#define U_MS_U &mmv MOVE_UP
#define U_MS_D &mmv MOVE_DOWN
#define U_MS_L &mmv MOVE_LEFT
#define U_MS_R &mmv MOVE_RIGHT
#define ZMK_MOUSE_DEFAULT_MOVE_VAL 1200  //  600
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 20    // 10

&lt {
    flavor = "tap-preferred";
    quick-tap-ms = <180>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        LAYER0 {
            bindings = <
&kp ESC     &kp N1  &kp N2  &kp N3           &kp N4          &kp N5          &kp N6     &kp N7       &kp N8     &kp N9   &kp N0    &kp BACKSPACE
&lt 1 TAB   &kp Q   &kp W   &kp E            &kp R           &kp T           &kp Y      &kp U        &kp I      &kp O    &kp P     &kp BSLH
&kp CAPS    &kp A   &kp S   &kp D            &kp F           &kp G           &kp H      &kp J        &kp K      &kp L    &kp SEMI  &kp ENTER
&kp LSHIFT  &kp Z   &kp X   &kp C            &kp V           &kp B           &kp N      &kp M        &kp COMMA  &kp DOT  &kp FSLH  &kp RSHIFT
                            &mt LCTRL MINUS  &mt LALT EQUAL  &mt LGUI GRAVE  &lt 2 DEL  &lt 1 SPACE  &kp SQT
            >;

            display-name = "QWERT";
        };

        layer_1 {
            bindings = <
&trans  &kp F1    &kp F2     &kp F3    &kp F4    &kp F5  &kp F6  &kp F7    &kp F8    &kp F9     &kp F10  &kp F11
&trans  &trans    &kp PG_UP  &trans    &trans    &trans  &trans  &trans    &kp UP    &trans     &trans   &kp F12
&trans  &kp HOME  &kp PG_DN  &kp END   &trans    &trans  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans   &trans
&trans  &trans    &trans     &trans    &trans    &trans  &trans  &trans    &trans    &trans     &trans   &trans
                             &kp LBKT  &kp RBKT  &trans  &trans  &trans    &trans
            >;

            display-name = "MOUSE";
        };

        layer_2 {
            display-name = "CONTROL";
            bindings = <
&studio_unlock  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans       &trans  &trans  &trans  &trans  &trans
&trans          &bt BT_CLR    &bt BT_CLR_ALL  &trans        &trans        &bootloader   &bootloader  &trans  &trans  &trans  &trans  &trans
&trans          &trans        &trans          &trans        &trans        &trans        &trans       &trans  &trans  &trans  &trans  &trans
&trans          &trans        &trans          &trans        &trans        &trans        &trans       &trans  &trans  &trans  &trans  &trans
                                              &trans        &trans        &trans        &trans       &trans  &trans
            >;
        };
    };
};
