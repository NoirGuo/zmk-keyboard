if SHIELD_VELVET_DONGLE

config ZMK_SPLIT_ROLE_CENTRAL
    default y

if ZMK_DISPLAY

config SSD1306
    default y

config I2C
    default y

if LVGL

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif # LVGL

endif # ZMK_DISPLAY

endif

if SHIELD_VELVET_DONGLE || SHIELD_VELVET_PH_LEFT || SHIELD_VELVET_PH_RIGHT

config ZMK_SPLIT
    default y

config ZMK_RGB_UNDERGLOW
    select WS2812_STRIP
    select SPI
    
endif

